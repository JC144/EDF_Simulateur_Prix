{
  "name": "edf-simulateur-prix-import",
  "private": true,
  "type": "module",
  "description": "Outil local de mise à jour des grilles tarifaires depuis les PDFs fournisseurs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node update.mjs --check-only",
    "update": "node update.mjs",
    "update-all": "node update-all.mjs",
    "gen": "node tools/gen-tarifs-section.mjs && node tools/gen-tarif-pages.mjs",
    "gen:check": "node tools/gen-tarifs-section.mjs --check && node tools/gen-tarif-pages.mjs --check"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.54"
  }
}
